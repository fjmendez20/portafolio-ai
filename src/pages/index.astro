---
// src/pages/index.astro

import "../styles/global.css";

const nombre = "Fabian Mendez";
const titulo = "Especialista Arquitecto de Soluciones | AI & Chatbots";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{nombre} - Portafolio</title>
	</head>
	<body class="bg-[#021336] text-white font-sans">
		<main class="max-w-5xl mx-auto p-8">
			<section
				class="min-h-[90vh] md:min-h-[80vh] flex items-center justify-center py-10 md:py-16"
			>
				<div
					class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center"
				>
					<div class="relative group mx-auto order-1 md:order-1">
						<div
							class="absolute -inset-1 bg-gradient-to-r from-[#50C878] to-purple-600 rounded-full blur opacity-25"
						>
						</div>
						<div
							class="relative w-48 h-48 sm:w-64 sm:h-64 md:w-96 md:h-96 rounded-full overflow-hidden border-2 border-slate-700 bg-slate-800"
						>
							<img
								src="/photoFabian03.png"
								alt={nombre}
								class="w-full h-full object-cover object-center"
								style="object-position: 90% 10%;"
							/>
						</div>
						<div
							class="absolute bottom-2 -right-2 md:bottom-4 md:-right-4 bg-slate-900/90 border border-slate-700 p-2 md:p-3 rounded-xl backdrop-blur-sm shadow-xl"
						>
							<p
								class="text-[10px] md:text-xs text-gray-400 uppercase font-bold tracking-wider"
							>
								Experiencia
							</p>
							<p
								class="text-lg md:text-xl font-bold text-[#50C878]"
							>
								5+ Años
							</p>
						</div>
					</div>

					<div class="text-center md:text-left order-2 md:order-2">
						<h1
							class="text-4xl md:text-6xl font-bold mb-2 bg-gradient-to-r from-[#50C878] to-purple-500 text-transparent bg-clip-text leading-tight"
						>
							{nombre}
						</h1>
						<p
							class="text-lg md:text-xl text-[#50C878]/80 font-medium mb-6 uppercase tracking-widest text-sm"
						>
							{titulo}
						</p>
						<p
							class="text-gray-300 text-base md:text-lg leading-relaxed mb-6 px-2 md:px-0"
						>
							Especialista en <strong>IA Conversacional</strong> transformando
							la experiencia del cliente con LLMs y arquitecturas RAG.
						</p>

						<div
							class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start"
						>
							<a
								href="#proyectos"
								class="bg-[#40a160] text-white px-8 py-3 rounded-full font-medium text-center"
								>Ver Proyectos</a
							>
							<a
								href="#contacto"
								class="border border-slate-600 text-white px-8 py-3 rounded-full font-medium text-center"
								>Contactar</a
							>
						</div>
					</div>
				</div>
			</section>
			<section class="mb-16">
				<h2
					class="text-3xl font-bold mb-6 border-b border-gray-700 pb-2"
				>
					Tech Stack
				</h2>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					<div
						class="bg-slate-800 p-4 rounded-lg text-center hover:bg-slate-700"
					>
						Python
					</div>
					<div
						class="bg-slate-800 p-4 rounded-lg text-center hover:bg-slate-700"
					>
						Kore.ai
					</div>
					<div
						class="bg-slate-800 p-4 rounded-lg text-center hover:bg-slate-700"
					>
						LLMs & RAG
					</div>
					<div
						class="bg-slate-800 p-4 rounded-lg text-center hover:bg-slate-700"
					>
						Chatbot Design
					</div>
					<div
						class="bg-slate-800 p-4 rounded-lg text-center hover:bg-slate-700"
					>
						JavaScript
					</div>
					<div
						class="bg-slate-800 p-4 rounded-lg text-center hover:bg-slate-700"
					>
						LangGraph
					</div>
					<div
						class="bg-slate-800 p-4 rounded-lg text-center hover:bg-slate-700"
					>
						Legacy Fundamentals
					</div>
					<div
						class="bg-slate-800 p-4 rounded-lg text-center hover:bg-slate-700"
					>
						Web Fundamentals
					</div>
				</div>
			</section>

			<section id="proyectos" class="mt-20">
				<h2 class="text-3xl font-bold mb-10 flex items-center gap-3">
					<span class="bg-[#50C878] w-2 h-8 rounded-full"></span>
					Proyectos e Impacto
				</h2>

				<div class="grid gap-8">
					<div
						class="group relative bg-slate-800/50 p-5 md:p-8 rounded-3xl border border-slate-700 hover:border-[#50C878] transition-all"
					>
						<div
							class="flex flex-col md:flex-row justify-between mb-4"
						>
							<h3
								class="text-2xl font-bold text-white group-hover:text-[#50C878] transition"
							>
								Arquitectura RAG & Evaluación con RAGAS
							</h3>
							<span
								class="text-sm font-mono text-[#50C878] bg-[#50C878]/10 px-3 py-1 rounded-full h-fit"
							>
								Sybven | Regional
							</span>
						</div>
						<p class="text-gray-400 mb-6 leading-relaxed">
							Lideré el diseño de arquitecturas escalables basadas
							en <strong>RAG</strong>. Implementé un framework de
							evaluación avanzada utilizando <strong>RAGAS</strong
							>, midiendo métricas críticas como <em
								>Faithfulness</em
							>, <em>Answer Relevance</em> y <em
								>Context Precision</em
							> para optimizar el rendimiento de LLMs en el sector banca.
						</p>
						<div class="flex flex-wrap gap-3 mb-6">
							<span
								class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
								>Python</span
							>
							<span
								class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
								>RAGAS Framework</span
							>
							<span
								class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
								>Vector Databases</span
							>
						</div>
					</div>

					<div
						id="extra-projects"
						class="hidden opacity-0 translate-y-4 transition-all duration-500 ease-out contents"
					>
						<div
							class="group relative bg-slate-800/50 p-8 rounded-3xl border border-slate-700 hover:border-[#50C878] transition-all"
						>
							<div
								class="flex flex-col md:flex-row justify-between mb-4"
							>
								<h3
									class="text-2xl font-bold text-white group-hover:text-[#50C878] transition"
								>
									Implementación de Voicebots & Telefonía IP
								</h3>
								<span
									class="text-sm font-mono text-[#50C878] bg-[#50C878]/10 px-3 py-1 rounded-full h-fit"
								>
									Voice AI Specialist
								</span>
							</div>
							<p class="text-gray-400 mb-6 leading-relaxed">
								Diseño y despliegue de asistentes virtuales de
								voz integrando modelos de <strong>ASR</strong> y <strong
									>TTS</strong
								>. Implementé soluciones robustas mediante
								protocolos <strong>SIP</strong> para integración de
								voz sobre IP, permitiendo interacciones fluidas en
								canales telefónicos corporativos.
							</p>
							<div class="flex flex-wrap gap-3 mb-6">
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>ASR / TTS</span
								>
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>SIP Protocol</span
								>
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>VoIP</span
								>
							</div>
						</div>
						<div
							class="group relative bg-slate-800/50 p-8 rounded-3xl border border-slate-700 hover:border-[#50C878] transition-all"
						>
							<div
								class="flex flex-col md:flex-row justify-between mb-4"
							>
								<h3
									class="text-2xl font-bold text-white group-hover:text-[#50C878] transition"
								>
									Ecosistema Conversacional Enterprise
								</h3>
								<span
									class="text-sm font-mono text-[#50C878] bg-[#50C878]/10 px-3 py-1 rounded-full h-fit"
								>
									Kore.ai Specialist
								</span>
							</div>
							<p class="text-gray-400 mb-6 leading-relaxed">
								Desarrollo avanzado de chatbots utilizando
								<strong>Kore.ai</strong> y <strong
									>JavaScript</strong
								>. Implementé flujos de datos complejos mediante
								integraciones con <strong>Salesforce</strong>,
								<strong>Zendesk</strong> y <strong
									>Genesys</strong
								>, optimizando la CX (Customer Experience) a
								través de sistemas NLU/NLP contextuales.
							</p>
							<div class="flex flex-wrap gap-3 mb-6">
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>Kore.ai</span
								>
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>JavaScript</span
								>
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>API Restful</span
								>
							</div>
						</div>

						<div
							class="group relative bg-slate-800/50 p-8 rounded-3xl border border-slate-700 hover:border-[#50C878] transition-all"
						>
							<div
								class="flex flex-col md:flex-row justify-between mb-4"
							>
								<h3
									class="text-2xl font-bold text-white group-hover:text-[#50C878] transition"
								>
									Automatización Omnicanal Latam
								</h3>
								<span
									class="text-sm font-mono text-[#50C878] bg-[#50C878]/10 px-3 py-1 rounded-full h-fit"
								>
									Impacto Regional
								</span>
							</div>
							<p class="text-gray-400 mb-6 leading-relaxed">
								Diseño y despliegue de soluciones basadas en
								LLMs para Panamá, República Dominicana, Ecuador
								y Paraguay. Integré canales de <strong
									>WhatsApp Business API</strong
								> y optimicé flujos mediante el análisis detallado
								de métricas de intención y entidades.
							</p>
							<div class="flex flex-wrap gap-3 mb-6">
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>WhatsApp API</span
								>
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>NLU Setup</span
								>
								<span
									class="bg-slate-700 px-3 py-1 rounded-md text-sm text-gray-300"
									>Multi-country Deploy</span
								>
							</div>
						</div>
					</div>
				</div>

				<div class="mt-12 text-center">
					<button
						id="load-more-btn"
						class="inline-flex items-center gap-2 px-8 py-3 bg-slate-800 hover:bg-slate-700 text-white rounded-full border border-slate-700 transition-all cursor-pointer group"
					>
						<span id="btn-text">Ver todos los proyectos</span>
						<svg
							id="btn-icon"
							xmlns="http://www.w3.org/2000/svg"
							class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-1"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M19 9l-7 7-7-7"></path>
						</svg>
					</button>
				</div>
			</section>
			<section id="experiencia" class="py-20 border-t border-slate-800">
				<div class="mb-12">
					<h2 class="text-3xl font-bold text-white mb-2">
						Impacto Regional en Latam
					</h2>
					<p
						class="text-blue-400 font-mono text-sm uppercase tracking-widest"
					>
						Liderazgo de proyectos en 4 países
					</p>
				</div>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
				>
					<div
						class="bg-slate-800/40 border border-slate-700 p-6 rounded-2xl hover:bg-blue-500/10 transition-colors group"
					>
						<div
							class="text-4xl mb-4 group-hover:scale-110 transition-transform"
						>
							🇵🇦
						</div>
						<h3 class="text-xl font-bold text-white mb-2">
							Panamá
						</h3>
						<p class="text-sm text-gray-400 mb-4">Sector Banca</p>
						<ul class="text-xs text-gray-500 space-y-2">
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Despliegue de Chatbots con Kore.ai
							</li>
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Integración con Zendesk
							</li>
						</ul>
					</div>

					<div
						class="bg-slate-800/40 border border-slate-700 p-6 rounded-2xl hover:bg-blue-500/10 transition-colors group"
					>
						<div
							class="text-4xl mb-4 group-hover:scale-110 transition-transform"
						>
							🇩🇴
						</div>
						<h3 class="text-xl font-bold text-white mb-2">
							Rep. Dominicana
						</h3>
						<p class="text-sm text-gray-400 mb-4">Sector Banca</p>
						<ul class="text-xs text-gray-500 space-y-2">
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Despliegue de Chatbots con Kore.ai
							</li>
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Asistente de Voz con Kore.ai
							</li>
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								WhatsApp Business API
							</li>
						</ul>
					</div>

					<div
						class="bg-slate-800/40 border border-slate-700 p-6 rounded-2xl hover:bg-blue-500/10 transition-colors group"
					>
						<div
							class="text-4xl mb-4 group-hover:scale-110 transition-transform"
						>
							🇪🇨
						</div>
						<h3 class="text-xl font-bold text-white mb-2">
							Ecuador
						</h3>
						<p class="text-sm text-gray-400 mb-4">Sector Seguros</p>
						<ul class="text-xs text-gray-500 space-y-2">
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Despliegue de Chatbots con Kore.ai
							</li>
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Fine-tuning LLMs
							</li>
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Reducción de tickets en 30%
							</li>
						</ul>
					</div>

					<div
						class="bg-slate-800/40 border border-slate-700 p-6 rounded-2xl hover:bg-blue-500/10 transition-colors group"
					>
						<div
							class="text-4xl mb-4 group-hover:scale-110 transition-transform"
						>
							🇵🇾
						</div>
						<h3 class="text-xl font-bold text-white mb-2">
							Paraguay
						</h3>
						<p class="text-sm text-gray-400 mb-4">Estrategia AI</p>
						<ul class="text-xs text-gray-500 space-y-2">
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Arquitectura RAG Corporativa
							</li>
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Fine-tuning LLMs
							</li>
							<li class="flex items-center gap-2">
								<span class="w-1 h-1 bg-blue-500 rounded-full"
								></span>
								Evaluación RAG
							</li>
						</ul>
					</div>
				</div>
			</section>
			<section class="py-20">
				<div class="grid md:grid-cols-2 gap-16">
					<div>
						<h3
							class="text-xl font-bold text-white mb-6 flex items-center gap-2"
						>
							<span class="text-blue-500 font-mono">01.</span> IA &
							Ingeniería
						</h3>
						<div class="flex flex-wrap gap-3">
							<span
								class="bg-blue-500/10 border border-blue-500/30 text-blue-300 px-4 py-2 rounded-lg text-sm"
								>LLMs (OpenAI, Gemini)</span
							>
							<span
								class="bg-blue-500/10 border border-blue-500/30 text-blue-300 px-4 py-2 rounded-lg text-sm"
								>Python (Fine-tuning)</span
							>
							<span
								class="bg-blue-500/10 border border-blue-500/30 text-blue-300 px-4 py-2 rounded-lg text-sm"
								>Arquitecturas RAG</span
							>
							<span
								class="bg-blue-500/10 border border-blue-500/30 text-blue-300 px-4 py-2 rounded-lg text-sm"
								>Kore.ai Specialist</span
							>
							<span
								class="bg-blue-500/10 border border-blue-500/30 text-blue-300 px-4 py-2 rounded-lg text-sm"
								>NLU/NLP Training</span
							>
							<span
								class="bg-blue-500/10 border border-blue-500/30 text-blue-300 px-4 py-2 rounded-lg text-sm"
								>Evaluación RAG (RAGAS)</span
							>
						</div>
					</div>

					<div>
						<h3
							class="text-xl font-bold text-white mb-6 flex items-center gap-2"
						>
							<span class="text-purple-500 font-mono">02.</span> Estrategia
							& Ecosistema
						</h3>
						<div class="flex flex-wrap gap-3">
							<span
								class="bg-purple-500/10 border border-purple-500/30 text-purple-300 px-4 py-2 rounded-lg text-sm"
								>Liderazgo de Equipos</span
							>
							<span
								class="bg-purple-500/10 border border-purple-500/30 text-purple-300 px-4 py-2 rounded-lg text-sm"
								>Análisis de ROI / Métricas</span
							>
							<span
								class="bg-purple-500/10 border border-purple-500/30 text-purple-300 px-4 py-2 rounded-lg text-sm"
								>Salesforce & Zendesk</span
							>
							<span
								class="bg-purple-500/10 border border-purple-500/30 text-purple-300 px-4 py-2 rounded-lg text-sm"
								>WhatsApp Business</span
							>
							<span
								class="bg-purple-500/10 border border-purple-500/30 text-purple-300 px-4 py-2 rounded-lg text-sm"
								>Estrategia de Datos Ética</span
							>
							<span
								class="bg-purple-500/10 border border-purple-500/30 text-purple-300 px-4 py-2 rounded-lg text-sm"
								>Genesys</span
							>
						</div>
					</div>
				</div>
			</section>
			<section class="mt-20 grid md:grid-cols-3 gap-6">
				<div
					class="p-6 border border-slate-800 rounded-xl hover:bg-slate-800/30"
				>
					<h4 class="font-bold mb-2">🤖 AI Strategy</h4>
					<p class="text-sm text-gray-500">
						Diseño de roadmaps para integración de GenAI en procesos
						legacy.
					</p>
				</div>
				<div
					class="p-6 border border-slate-800 rounded-xl hover:bg-slate-800/30"
				>
					<h4 class="font-bold mb-2">📊 Data Governance</h4>
					<p class="text-sm text-gray-500">
						Gestión de calidad y ética de datos para entrenamiento
						de modelos.
					</p>
				</div>
				<div
					class="p-6 border border-slate-800 rounded-xl hover:bg-slate-800/30"
				>
					<h4 class="font-bold mb-2">👥 Team Leadership</h4>
					<p class="text-sm text-gray-500">
						Coordinación de equipos multidisciplinarios (Devs, Data
						Scientists, UX).
					</p>
				</div>
			</section>
			<section
				id="contacto"
				class="py-20 border-t border-slate-800 px-4 md:px-0"
			>
				<div class="max-w-2xl mx-auto">
					<div class="text-center mb-12">
						<h2 class="text-3xl font-bold text-white mb-4">
							¿Tienes un proyecto en mente?
						</h2>
						<p class="text-gray-400">
							Estoy disponible para consultorías de IA, liderazgo
							de proyectos o roles de AI Management.
						</p>
					</div>

					<form
						action="https://formspree.io/f/xdaewknd"
						method="POST"
						class="space-y-6"
					>
						<div class="grid md:grid-cols-2 gap-6">
							<div>
								<label
									class="block text-sm font-medium text-gray-400 mb-2"
									>Nombre</label
								>
								<input
									type="text"
									name="name"
									required
									class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-blue-500 transition"
