	<script>
		const btn = document.getElementById("load-more-btn");
		const extra = document.getElementById("extra-projects");
		const btnText = document.getElementById("btn-text");
		const btnIcon = document.getElementById("btn-icon");

		btn?.addEventListener("click", () => {
			const isHidden = extra?.classList.contains("hidden");
			if (isHidden) {
				extra?.classList.remove("hidden");
				// Timeout para permitir que el DOM detecte el cambio antes de animar
				setTimeout(() => {
					extra?.classList.remove("opacity-0", "translate-y-4");
				}, 10);
				btnText!.textContent = "Ver menos";
				btnIcon!.style.transform = "rotate(180deg)";
			} else {
				extra?.classList.add("opacity-0", "translate-y-4");
				setTimeout(() => {
					extra?.classList.add("hidden");
				}, 500);
				btnText!.textContent = "Ver todos los proyectos";
				btnIcon!.style.transform = "rotate(0deg)";
				// Scroll suave hacia arriba de la sección al cerrar
				document
					.getElementById("proyectos")
					?.scrollIntoView({ behavior: "smooth" });
			}
		});
	</script>
</html>
