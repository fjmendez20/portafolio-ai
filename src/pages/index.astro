	<script>
		// 1. Seleccionamos el formulario de contacto usando su atributo action
		const contactForm = document.querySelector('form[action^="https://formspree.io"]');
		
		contactForm?.addEventListener('submit', async (e) => {
			e.preventDefault(); // Evita la redirección a la página de "Gracias"
			
			const form = e.target;
			const formData = new FormData(form);
			const submitBtn = form.querySelector('button[type="submit"]');
			const originalBtnText = submitBtn.innerHTML;
	
			// 2. Feedback visual: Deshabilitar botón y mostrar estado de carga
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.innerHTML = "Enviando...";
			}
	
			try {
				// 3. Enviamos los datos mediante fetch (AJAX)
				const response = await fetch(form.action, {
					method: 'POST',
					body: formData,
					headers: {
						'Accept': 'application/json'
					}
				});
	
				if (response.ok) {
					// ÉXITO: Limpiamos el formulario y avisamos al usuario
					form.reset();
					alert("¡Mensaje enviado con éxito! Me pondré en contacto pronto.");
				} else {
					// Manejo de errores del servidor (ej. Formspree rechazó el envío)
					const data = await response.json();
					alert(data.errors ? data.errors.map(error => error.message).join(", ") : "Error al enviar.");
				}
			} catch (error) {
				// Manejo de errores de red
				alert("Hubo un error de conexión. Por favor, inténtalo de nuevo.");
			} finally {
				// 4. Restauramos el botón a su estado original
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.innerHTML = originalBtnText;
				}
			}
		});
	</script>
</body> 
	

</html>
	<script>
		/**
		 * @typedef {{ nombre?: string, titulo?: string }} PageProps
		 */
		/** @type {PageProps} */
		window.PAGE_PROPS = window.PAGE_PROPS ?? {};
		// Exponer props del frontmatter al cliente: window.PAGE_PROPS
		try {
			const _p = document.querySelector('main')?.dataset.props || '{}';
			window.PAGE_PROPS = JSON.parse(_p);
		} catch (e) {
			window.PAGE_PROPS = window.PAGE_PROPS || {};
		}
		// Actualizar saludo del asistente con el nombre real desde PAGE_PROPS
		try {
			const g = document.getElementById('assistant-greeting');
			if (g) {
				const n = window.PAGE_PROPS?.nombre || 'Fabian';
				g.textContent = `¡Hola! Soy el asistente virtual de ${n}. ¿En qué puedo ayudarte hoy?`;
			}
		} catch (e) {
			/* no-op */
		}
		/** @type {HTMLElement | null} */
		const toggleBtn = document.getElementById("chat-toggle-btn");
		/** @type {HTMLElement | null} */
		const closeBtn = document.getElementById("chat-close-btn");
		/** @type {HTMLElement | null} */
		const chatWindow = document.getElementById("chat-window");
		/** @type {HTMLFormElement | null} */
		const chatForm = document.getElementById("chat-form");
		/** @type {HTMLInputElement | null} */
		const chatInput = document.getElementById("chat-input");
		/** @type {HTMLElement | null} */
		const chatMessages = document.getElementById("chat-messages");
		/** @type {HTMLButtonElement | null} */
		const sendBtn = document.getElementById("send-btn");

		let isChatOpen = false;
		// 0. GESTIÓN DE SESIÓN PROFESIONAL (localStorage)
		let sessionId = localStorage.getItem('chat_session_id');
		if (!sessionId) {
			// Si es un usuario nuevo, le creamos un ID único seguro
			// Usamos crypto.randomUUID() que es el estándar moderno de navegadores
			sessionId = 'User-' + crypto.randomUUID();
			localStorage.setItem('chat_session_id', sessionId);
		}

		// 2. LA FUNCIÓN DEL BOTÓN (Ya no hace el ping, solo abre la ventana)
		function toggleChat() {
		isChatOpen = !isChatOpen;
		const tooltip = document.getElementById("chat-tooltip");
		if (isChatOpen) {
			chatWindow?.classList.remove("scale-90", "opacity-0", "pointer-events-none", "invisible");
			chatWindow?.classList.add("scale-100", "opacity-100");
			toggleBtn?.classList.add("chat-open");
			tooltip?.classList.add("hidden");
			setTimeout(() => chatInput?.focus(), 300);
		} else {
			chatWindow?.classList.remove("scale-100", "opacity-100");
			chatWindow?.classList.add("scale-90", "opacity-0", "pointer-events-none", "invisible");
			toggleBtn?.classList.remove("chat-open");
			tooltip?.classList.remove("hidden");
		}
		}

		toggleBtn?.addEventListener("click", toggleChat);
		closeBtn?.addEventListener("click", toggleChat);

		// Función para añadir mensajes al UI
		/**
		 * Añade un mensaje al UI
		 * @param {string} text
		 * @param {'user'|'bot'} sender
		 */
// 1. Saludo inicial estilo Fabian AI
try {
            const initContainer = document.getElementById('initial-message-container');
            if (initContainer) {
                const now = new Date();
                const time = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }).toLowerCase();
                
                initContainer.innerHTML = `
                    <div class="mb-4">

                    </div>
                `;
            }
        } catch (e) {}

		function addMessage(text, sender) {
            const isUser = sender === "user";
            const now = new Date();
            const time = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }).toLowerCase();

            // Convertir el texto Markdown a HTML (solo si es el bot, o ambos, como prefieras)
            // Usamos breaks: true para que los saltos de línea normales se conviertan en <br>
            marked.setOptions({ breaks: true });
            const parsedText = isUser ? text : marked.parse(text);

            const wrapper = document.createElement("div");
            wrapper.className = "mb-6 animate-in fade-in slide-in-from-bottom-2 duration-300";

            wrapper.innerHTML = `
                <div class="text-[10px] text-white-500 font-bold mb-1 ${isUser ? "text-right pr-2" : "pl-11"} uppercase tracking-wider">
                    ${isUser ? "Tú" : "Asistente AI"} <span class="font-normal opacity-95">${time}</span>
                </div>
                <div class="flex items-start gap-3 ${isUser ? "justify-end" : ""}">
                    ${!isUser ? `<img src="/avatar.png" class="w-8 h-8 rounded-full border border-slate-700 shrink-0 object-cover" />` : ""}
                    <div class="${isUser ? "bg-[#50C878] text-[#021336] font-medium" : "bg-slate-800 text-gray-200 border border-slate-700 markdown-chat"} p-3.5 rounded-2xl ${isUser ? "rounded-tr-none" : "rounded-tl-none"} text-sm shadow-lg max-w-[85%] break-words">
                        ${parsedText}
                    </div>
                </div>
            `;

            if (chatMessages) {
                chatMessages.appendChild(wrapper);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }

		// Bandera de control para evitar spam de clics
		let isProcessing = false;

		// Manejo del envío del formulario
		chatForm?.addEventListener("submit", async (e) => {
			e.preventDefault();
			
			// Si ya está procesando una petición, bloqueamos las siguientes
			if (isProcessing) return;

			const message = (chatInput?.value || "").trim();
			if (!message) return;

			// Bloqueamos el estado y la UI
			isProcessing = true;
			if (sendBtn) sendBtn.disabled = true;

			// 1. Mostrar mensaje del usuario
			addMessage(message, "user");
			if (chatInput) chatInput.value = "";

			// 2. Mostrar indicador de "Escribiendo..." temporal
			const loadingDiv = document.createElement("div");
            loadingDiv.id = "loading-indicator";
            loadingDiv.className = "mb-6";
            loadingDiv.innerHTML = `
                <div class="text-[10px] text-gray-500 font-bold mb-1 pl-11">ASISTENTE AI</div>
                <div class="flex items-start gap-3">
                    <img src="/avatar.png" class="w-8 h-8 rounded-full border border-slate-700 shrink-0 object-cover" />
                    <div class="bg-slate-800 p-4 rounded-2xl rounded-tl-none border border-slate-700 flex gap-1">
                        <span class="w-1.5 h-1.5 bg-[#50C878] rounded-full animate-bounce"></span>
                        <span class="w-1.5 h-1.5 bg-[#50C878] rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
                        <span class="w-1.5 h-1.5 bg-[#50C878] rounded-full animate-bounce" style="animation-delay: 0.4s"></span>
                    </div>
                </div>
            `;
			if (chatMessages) {
				chatMessages.appendChild(loadingDiv);
				chatMessages.scrollTop = chatMessages.scrollHeight;
			}

			// 3. ÚNICA llamada a la API
			try {
				const response = await fetch('/api/chat', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ 
						message: message,
						session_id: sessionId
					 })
				});
				
				const data = await response.json();
				
				// Eliminar indicador de carga y mostrar respuesta real
				document.getElementById('loading-indicator')?.remove();
				addMessage(data.reply, 'bot');

				// Actualizar estado a Online en la UI
				const statusText = document.getElementById('chat-status-text');
				if (statusText) {
					statusText.className = "text-xs text-[#50C878] font-mono flex items-center gap-1";
					statusText.innerHTML = '<span class="w-2 h-2 bg-[#50C878] rounded-full"></span>Online';
				}

			} catch (error) {
				document.getElementById('loading-indicator')?.remove();
				addMessage("Lo siento, tuve un problema técnico de conexión. ¿Podrías intentar de nuevo?", 'bot');
				console.error("Error en el chat:", error);
			} finally {
				// Liberamos el bloqueo al terminar (sea éxito o error)
				isProcessing = false;
				if (sendBtn) sendBtn.disabled = false;
				chatInput?.focus();
			}
		});
	</script>

