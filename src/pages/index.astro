	<script>
		/**
		 * @typedef {{ nombre?: string, titulo?: string }} PageProps
		 */
		/** @type {PageProps} */
		window.PAGE_PROPS = window.PAGE_PROPS ?? {};
		// Exponer props del frontmatter al cliente: window.PAGE_PROPS
		try {
			const _p = document.querySelector('main')?.dataset.props || '{}';
			window.PAGE_PROPS = JSON.parse(_p);
		} catch (e) {
			window.PAGE_PROPS = window.PAGE_PROPS || {};
		}
		// Actualizar saludo del asistente con el nombre real desde PAGE_PROPS
		try {
			const g = document.getElementById('assistant-greeting');
			if (g) {
				const n = window.PAGE_PROPS?.nombre || 'Fabian';
				g.textContent = `¡Hola! Soy el asistente virtual de ${n}. ¿En qué puedo ayudarte hoy?`;
			}
		} catch (e) {
			/* no-op */
		}
		/** @type {HTMLElement | null} */
		const toggleBtn = document.getElementById("chat-toggle-btn");
		/** @type {HTMLElement | null} */
		const closeBtn = document.getElementById("chat-close-btn");
		/** @type {HTMLElement | null} */
		const chatWindow = document.getElementById("chat-window");
		/** @type {HTMLFormElement | null} */
		const chatForm = document.getElementById("chat-form");
		/** @type {HTMLInputElement | null} */
		const chatInput = document.getElementById("chat-input");
		/** @type {HTMLElement | null} */
		const chatMessages = document.getElementById("chat-messages");
		/** @type {HTMLButtonElement | null} */
		const sendBtn = document.getElementById("send-btn");
		/** @type {HTMLElement | null} */
		const bootSplash = document.getElementById("boot-splash");
		/** @type {HTMLElement | null} */
		const bootBar = document.getElementById("boot-bar");
		/** @type {HTMLElement | null} */
		const bootTrack = document.getElementById("boot-track");
		/** @type {HTMLElement | null} */
		const bootStatusText = document.getElementById("boot-status-text");
		/** @type {HTMLElement | null} */
		const bootCounter = document.getElementById("boot-counter");
		/** @type {HTMLElement | null} */
		const bootTypewriter = document.getElementById("boot-typewriter");
		/** @type {HTMLButtonElement | null} */
		const bootSkip = document.getElementById("boot-skip");

		let isChatOpen = false;
		// 0. GESTIÓN DE SESIÓN PROFESIONAL (localStorage)
		let sessionId = localStorage.getItem('chat_session_id');
		if (!sessionId) {
			// Si es un usuario nuevo, le creamos un ID único seguro
			// Usamos crypto.randomUUID() que es el estándar moderno de navegadores
			sessionId = 'User-' + crypto.randomUUID();
			localStorage.setItem('chat_session_id', sessionId);
		}

		// 2. LA FUNCIÓN DEL BOTÓN
		/** @param {'online'|'waking'|'offline'} state */
		let agentStatus = 'waking';

		/* ---------------------------------------------------------------
		   Pantalla de arranque
		   ---------------------------------------------------------------
		   La barra se dibuja en 30s como referencia visual, pero lo que
		   desbloquea el input es el estado REAL del agente: en cuanto
		   /api/wake responde `awake` el header pasa a "Online" y se cierra
		   la espera. Si Render despierta en 8s, el usuario espera 8s; si
		   tarda 50s, la barra entra en modo "esperando" y la espera sigue.
		   --------------------------------------------------------------- */
		const CHAT_PLACEHOLDER = 'Pregúntame sobre sus proyectos...';
		const BOOT_BAR_MS = 30_000;
		const BOOT_STATUS_MS = 6_000;
		/** Si el agente se despertó hace poco, Render sigue caliente. */
		const AWAKE_TTL_MS = 15 * 60 * 1000;

		const BOOT_STATUSES = [
			'Despertando el servidor…',
			'Cargando el contexto del portafolio…',
			'Ajustando los modelos…',
			'Casi listo, un segundo…',
		];

		let isBooting = true;
		let bootStarted = false;
		let bootCountdownTimer = 0;
		let bootStatusTimer = 0;
		/** @type {Promise<void> | null} */
		let bootTyping = null;

		function agentName() {
			return window.PAGE_PROPS?.nombre || 'Fabian';
		}

		function greeting() {
			return `¡Hola! Soy el asistente virtual de ${agentName()}. ¿En qué puedo ayudarte hoy?`;
		}

		function rememberAgentAwake() {
			try {
				localStorage.setItem('agent_awake_at', String(Date.now()));
			} catch (e) {
				/* modo privado: solo se pierde la optimización */
			}
		}

		/** ¿Render sigue despierto según la última visita de este navegador? */
		function isAgentWarm() {
			try {
				const at = Number(localStorage.getItem('agent_awake_at') || 0);
				return at > 0 && Date.now() - at < AWAKE_TTL_MS;
			} catch (e) {
				return false;
			}
		}

		/**
		 * Bloquea o desbloquea la escritura. Durante el arranque el input estuvo
		 * siempre editable: el usuario escribía, leía los 3 puntitos y acumulaba
		 * texto a ciegas durante casi un minuto.
		 * @param {boolean} enabled
		 */
		function setInputEnabled(enabled) {
			if (chatInput) {
				chatInput.disabled = !enabled;
				chatInput.placeholder = enabled ? CHAT_PLACEHOLDER : 'Despertando el asistente…';
				chatInput.setAttribute('aria-busy', enabled ? 'false' : 'true');
			}
			if (sendBtn) sendBtn.disabled = !enabled;
		}

		/**
		 * Escribe el saludo carácter a carácter y devuelve una promesa que se
		 * resuelve al terminar, para que finishBoot nunca lo corte a la mitad.
		 * @param {string} text
		 * @param {number} msPerChar
		 * @returns {Promise<void>}
		 */
		function typewrite(text, msPerChar) {
			return new Promise((resolve) => {
				if (!bootTypewriter) return resolve();
				bootTypewriter.textContent = '';
				let i = 0;
				const tick = () => {
					i += 1;
					bootTypewriter.textContent = text.slice(0, i);
					if (i < text.length) {
						window.setTimeout(tick, msPerChar);
					} else {
						resolve();
					}
				};
				window.setTimeout(tick, msPerChar);
			});
		}

		/** Cuenta atrás de la barra. Al llegar a 0 la barra pulsa, no se reinicia. */
		function startBootCountdown() {
			let remaining = BOOT_BAR_MS / 1000;
			if (bootCounter) bootCounter.textContent = `${remaining}s`;
			bootBar?.classList.add('boot-bar--running');
			window.clearInterval(bootCountdownTimer);
			bootCountdownTimer = window.setInterval(() => {
				remaining = Math.max(0, remaining - 1);
				if (bootCounter) {
					bootCounter.textContent = remaining > 0 ? `${remaining}s` : 'lento…';
				}
				if (remaining === 0) bootTrack?.classList.add('boot-track--stalled');
			}, 1000);
		}

		/** Rótulos que explican qué está pasando, en vez de una barra muda. */
		function startBootStatus() {
			let index = 0;
			window.clearInterval(bootStatusTimer);
			bootStatusTimer = window.setInterval(() => {
				if (!bootStatusText) return;
				index = (index + 1) % BOOT_STATUSES.length;
				bootStatusText.textContent = BOOT_STATUSES[index];
				// Reinicia la animación de entrada del texto.
				bootStatusText.classList.remove('boot-status--swap');
				void bootStatusText.offsetWidth;
				bootStatusText.classList.add('boot-status--swap');
			}, BOOT_STATUS_MS);
		}

		/**
		 * Arranca la pantalla de arranque. Idempotente: reabrir el widget durante
		 * la espera no reinicia ni el typewriter ni la cuenta atrás.
		 */
		function startBoot() {
			if (!isBooting || bootStarted || !bootSplash) return;
			bootStarted = true;

			bootSplash.classList.remove('is-out');
			bootSplash.classList.add('is-on');
			setInputEnabled(false);

			// Con Render ya caliente el mismo splash se muestra, pero el texto
			// aparece mucho más rápido porque no hay nada que esperar.
			bootTyping = typewrite(greeting(), isAgentWarm() ? 12 : 26);
			startBootCountdown();
			startBootStatus();
		}

		/**
		 * Cierra la pantalla de arranque y habilita la escritura. La dispara el
		 * estado real del agente (`online`), el botón de saltar, o el timeout de
		 * /api/wake para no dejar al usuario atrapado.
		 * @param {{ slow?: boolean }} [opts]
		 */
		async function finishBoot(opts) {
			if (!isBooting) return;
			const slow = opts?.slow === true;
			isBooting = false;
			bootStarted = false;

			window.clearInterval(bootCountdownTimer);
			window.clearInterval(bootStatusTimer);
			bootBar?.classList.remove('boot-bar--running');
			bootTrack?.classList.remove('boot-track--stalled');

			// No cortamos el typewriter a la mitad: el saludo siempre queda legible.
			if (bootTyping) await bootTyping;

			const closingText = slow
				? 'Tuve un arranque lento, pero ya podés escribirme. Con tu primera pregunta termino de despertar.'
				: bootTypewriter?.textContent;

			// Primero sacamos el splash del flujo; recién ahí entra el saludo como
			// primera burbuja real, así no queda un hueco en medio del chat.
			bootSplash?.classList.remove('is-on');
			bootSplash?.classList.add('is-out');
			window.setTimeout(() => {
				bootSplash?.classList.remove('is-out');
				if (closingText) addMessage(closingText, 'bot');
			}, 360);

			setInputEnabled(true);
			if (isChatOpen) chatInput?.focus();
		}

		bootSkip?.addEventListener('click', () => finishBoot());

		function setChatStatus(state) {
			agentStatus = state;

			// El estado del agente es lo que cierra la espera: en cuanto Render
			// responde, el usuario puede escribir.
			if (state === 'online' && isBooting) {
				rememberAgentAwake();
				finishBoot();
			} else if (state === 'offline' && isBooting) {
				// /api/wake agotó sus 45s. Dejar el input bloqueado para siempre
				// sería peor que dejar escribir: el submit reintenta el wake en
				// cada envío.
				finishBoot({ slow: true });
			}

			const statusText = document.getElementById('chat-status-text');
			if (!statusText) return;
			const map = {
				online: ['text-[#50C878]', 'bg-[#50C878]', 'Online'],
				waking: ['text-yellow-500', 'bg-yellow-500', 'Conectando...'],
				offline: ['text-red-400', 'bg-red-400', 'Sin conexión'],
			};
			const [textClass, dotClass, label] = map[state];
			statusText.className = `text-[11px] ${textClass} font-mono flex items-center gap-1.5 mt-0.5`;
			statusText.innerHTML = `<span class="w-2 h-2 ${dotClass} rounded-full animate-pulse"></span>${label}`;
		}

		/**
		 * Despierta el agente de Render free. El cold start puede tardar 30-50s,
		 * así que se dispara al abrir el widget y se espera antes de enviar si el
		 * agente no está confirmado como online.
		 * Devuelve la promesa del wake en curso para poder esperarla.
		 */
		let wakeInFlight = null;
		async function wakeAgent() {
			if (wakeInFlight) return wakeInFlight;
			setChatStatus('waking');
			wakeInFlight = (async () => {
				try {
					const res = await fetch('/api/wake');
					const data = await res.json();
					setChatStatus(data.status === 'awake' ? 'online' : 'offline');
					console.log('🟢 Wake:', JSON.stringify(data));
				} catch (e) {
					// No es crítico: si Render está despierto igual responderá.
					console.warn('🟡 Wake sin respuesta:', e);
					setChatStatus('offline');
				}
			})();
			await wakeInFlight;
			wakeInFlight = null;
		}

		function toggleChat() {
		isChatOpen = !isChatOpen;
		const tooltip = document.getElementById("chat-tooltip");
		if (isChatOpen) {
			chatWindow?.classList.remove("scale-90", "opacity-0", "pointer-events-none", "invisible");
			chatWindow?.classList.add("scale-100", "opacity-100");
			toggleBtn?.classList.add("chat-open");
			tooltip?.classList.add("hidden");
			// La espera arranca antes que el wake: el splash y la petición a Render
			// avanzan en paralelo, así se aprovecha todo el cold start.
			startBoot();
			wakeAgent();
			setTimeout(() => {
				if (!isBooting) chatInput?.focus();
			}, 300);
		} else {
			chatWindow?.classList.remove("scale-100", "opacity-100");
			chatWindow?.classList.add("scale-90", "opacity-0", "pointer-events-none", "invisible");
			toggleBtn?.classList.remove("chat-open");
			tooltip?.classList.remove("hidden");
		}
		}

		toggleBtn?.addEventListener("click", toggleChat);
		closeBtn?.addEventListener("click", toggleChat);

		// Función para añadir mensajes al UI
		/**
		 * Añade un mensaje al UI
		 * @param {string} text
		 * @param {'user'|'bot'} sender
		 */
// El saludo inicial lo escribe la pantalla de arranque (typewrite +
		// finishBoot). Antes este bloque renderizaba un <div> vacío y el chat
		// abría en blanco.

		function addMessage(text, sender) {
            const isUser = sender === "user";
            const now = new Date();
            const time = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }).toLowerCase();

            // Convertir el texto Markdown a HTML (solo si es el bot, o ambos, como prefieras)
            // Usamos breaks: true para que los saltos de línea normales se conviertan en <br>
            marked.setOptions({ breaks: true });
            const parsedText = isUser ? text : marked.parse(text);

            const wrapper = document.createElement("div");
            wrapper.className = "mb-6 msg-enter";

            wrapper.innerHTML = `
                <div class="text-[10px] text-gray-500 font-bold mb-1 ${isUser ? "text-right pr-2" : "pl-11"} uppercase tracking-wider">
                    ${isUser ? "Tú" : "Asistente AI"} <span class="font-normal opacity-95">${time}</span>
                </div>
                <div class="flex items-start gap-3 ${isUser ? "justify-end" : ""}">
                    ${!isUser ? `<img src="/avatar.png" class="w-8 h-8 rounded-full border border-slate-700 shrink-0 object-cover" />` : ""}
                    <div class="${isUser ? "bg-[#50C878] text-[#021336] font-medium" : "bg-slate-800 text-gray-200 border border-slate-700 markdown-chat"} p-3.5 rounded-2xl ${isUser ? "rounded-tr-none" : "rounded-tl-none"} text-sm shadow-lg max-w-[85%] break-words">
                        ${parsedText}
                    </div>
                </div>
            `;

            if (chatMessages) {
                chatMessages.appendChild(wrapper);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }

		// --- Streaming: burbuja que se rellena token a token ---
		/** Crea la burbuja del asistente y devuelve el nodo donde va el texto. */
		function createStreamingBubble() {
			const now = new Date();
			const time = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }).toLowerCase();

			const wrapper = document.createElement("div");
			wrapper.className = "mb-6 msg-enter";
			wrapper.innerHTML = `
				<div class="text-[10px] text-gray-500 font-bold mb-1 pl-11 uppercase tracking-wider">
					Asistente AI <span class="font-normal opacity-95">${time}</span>
				</div>
				<div class="flex items-start gap-3">
					<img src="/avatar.png" class="w-8 h-8 rounded-full border border-slate-700 shrink-0 object-cover" />
					<div class="bg-slate-800 text-gray-200 border border-slate-700 markdown-chat p-3.5 rounded-2xl rounded-tl-none text-sm shadow-lg max-w-[85%] break-words">
						<span class="inline-block w-1.5 h-1.5 bg-[#50C878] rounded-full animate-bounce"></span>
					</div>
				</div>
			`;

			if (chatMessages) {
				chatMessages.appendChild(wrapper);
				chatMessages.scrollTop = chatMessages.scrollHeight;
			}
			return wrapper.querySelector('.markdown-chat');
		}

		/** Escribe el texto en la burbuja y la mantiene siempre al final. */
		function paintBubble(bubble, text) {
			if (!bubble) return;
			marked.setOptions({ breaks: true });
			bubble.innerHTML = marked.parse(text);
			if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
		}

		/**
		 * Repintar en cada token satura el main thread y produce parpadeo.
		 * Agrupamos los repintados en ventanas de 60 ms.
		 */
		function paintThrottled(bubble, text) {
			bubble.dataset.raw = text;
			if (bubble._paintTimer) return;
			bubble._paintTimer = window.setTimeout(() => {
				bubble._paintTimer = null;
				paintBubble(bubble, bubble.dataset.raw || '');
			}, 60);
		}

		// Bandera de control para evitar spam de clics
		let isProcessing = false;

		// Indicador de "Asistente AI está escribiendo..." del exchanges normal
		// (posterior al arranque, cuando ya se puede escribir).
		function showTypingIndicator() {
			document.getElementById('loading-indicator')?.remove();
			const loadingDiv = document.createElement("div");
			loadingDiv.id = "loading-indicator";
			loadingDiv.className = "mb-6 msg-enter";
			loadingDiv.innerHTML = `
				<div class="text-[10px] text-gray-500 font-bold mb-1 pl-11 uppercase tracking-wider">Asistente AI</div>
				<div class="flex items-start gap-3">
					<img src="/avatar.png" alt="" class="w-8 h-8 rounded-full border border-slate-700 shrink-0 object-cover" />
					<div class="bg-slate-800 p-4 rounded-2xl rounded-tl-none border border-slate-700 flex gap-1">
						<span class="w-1.5 h-1.5 bg-[#50C878] rounded-full animate-bounce"></span>
						<span class="w-1.5 h-1.5 bg-[#50C878] rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
						<span class="w-1.5 h-1.5 bg-[#50C878] rounded-full animate-bounce" style="animation-delay: 0.4s"></span>
					</div>
				</div>
			`;
			if (chatMessages) {
				chatMessages.appendChild(loadingDiv);
				chatMessages.scrollTop = chatMessages.scrollHeight;
			}
		}

		// Manejo del envío del formulario
		chatForm?.addEventListener("submit", async (e) => {
			e.preventDefault();

			// Si ya está procesando una petición, bloqueamos las siguientes
			if (isProcessing) return;
			// Cinturón de seguridad: durante el arranque el input ya está deshabilitado.
			if (isBooting) return;

			const message = (chatInput?.value || "").trim();
			if (!message) return;

			// Bloqueamos el estado y la UI
			isProcessing = true;
			if (sendBtn) sendBtn.disabled = true;

			// 1. Mostrar mensaje del usuario
			addMessage(message, "user");
			if (chatInput) chatInput.value = "";

			// Si el agente no está confirmado online, esperamos a que termine el
			// wake. Así el cold start de Render lo cubre el wake y no el mensaje,
			// que abortaría a los 45s mientras Render tarda 30-60s en despertar.
			//
			// El indicador va DESPUÉS del wake a propósito: antes se insertaba antes
			// de esperar, así que el usuario veía "escribiendo..." durante el cold
			// start, cuando el modelo todavía no había generado ni un token.
			if (agentStatus !== 'online') {
				await wakeAgent();
			}

			showTypingIndicator();

			// 3. ÚNICA llamada a la API, ahora en streaming
			/** @type {HTMLElement | null} */
			let bubble = null;
			let streamedText = '';
			let finalText = '';
			let streamError = '';

			/**
			 * Procesa un frame SSE (`event: x\ndata: {...}`).
			 * @param {string} frame
			 */
			const handleFrame = (frame) => {
				let name = 'message';
				const dataLines = [];
				for (const line of frame.split('\n')) {
					if (line.startsWith('event:')) name = line.slice(6).trim();
					else if (line.startsWith('data:')) dataLines.push(line.slice(5).trim());
				}
				if (!dataLines.length) return;

				let payload;
				try {
					payload = JSON.parse(dataLines.join('\n'));
				} catch (e) {
					return;
				}

				if (name === 'delta' && payload.text) {
					if (!bubble) {
						document.getElementById('loading-indicator')?.remove();
						bubble = createStreamingBubble();
					}
					streamedText += payload.text;
					paintThrottled(bubble, streamedText);
				} else if (name === 'done') {
					finalText = payload.response || streamedText;
				} else if (name === 'error') {
					streamError = payload.message || 'Algo salió mal. ¿Intentamos de nuevo?';
				}
			};

			try {
				const response = await fetch('/api/chat', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'Accept': 'text/event-stream'
					},
					body: JSON.stringify({ 
						message: message,
						session_id: sessionId
						})
				});

				const contentType = response.headers.get('content-type') || '';

				// Red de seguridad: si el proxy devolvió JSON (error previo al
				// stream) en lugar de SSE, lo mostramos como mensaje normal.
				if (!contentType.includes('text/event-stream')) {
					const data = await response.json();
					document.getElementById('loading-indicator')?.remove();
					addMessage(data.reply || 'Lo siento, tuve un problema técnico. ¿Podrías intentar de nuevo?', 'bot');
					throw new Error('respuesta no-stream');
				}

				if (!response.body) throw new Error('stream sin body');

				const reader = response.body.getReader();
				const decoder = new TextDecoder('utf-8');
				let buffer = '';

				while (true) {
					const { done, value } = await reader.read();
					if (done) break;
					buffer += decoder.decode(value, { stream: true });

					// SSE separa los eventos con una línea en blanco.
					let boundary = buffer.indexOf('\n\n');
					while (boundary !== -1) {
						handleFrame(buffer.slice(0, boundary));
						buffer = buffer.slice(boundary + 2);
						boundary = buffer.indexOf('\n\n');
					}
				}

				document.getElementById('loading-indicator')?.remove();

				if (streamError) {
					const text = streamedText.trim()
						? `${streamedText}\n\n_${streamError}_`
						: streamError;
					if (bubble) paintBubble(bubble, text);
					else addMessage(text, 'bot');
				} else {
					const text = finalText || streamedText;
					if (text.trim() && bubble) paintBubble(bubble, text);
					else if (text.trim()) addMessage(text, 'bot');
					else addMessage("Lo siento, tuve un problema procesando tu mensaje. ¿Podrías repetirlo?", 'bot');
				}

				// Actualizar estado a Online en la UI
				setChatStatus('online');

			} catch (error) {
				document.getElementById('loading-indicator')?.remove();
				if (!bubble) {
					addMessage("Lo siento, tuve un problema técnico de conexión. ¿Podrías intentar de nuevo?", 'bot');
				}
				console.error("Error en el chat:", error);
			} finally {
				// Liberamos el bloqueo al terminar (sea éxito o error)
				isProcessing = false;
				if (sendBtn) sendBtn.disabled = false;
				chatInput?.focus();
			}
		});
	</script>

	<!--
		is:global es OBLIGATORIO acá. Por defecto Astro scopea los estilos de un
		componente a `data-astro-cid-*`, atributo que solo reciben los elementos del
		propio template. Casi todo el chat se arma con document.createElement +
		innerHTML, así que sus nodos (y los <p>/<ul>/<code> que genera marked.parse)
		nunca llevan ese atributo y las reglas nunca aplicaban: .msg-enter y las 12
		rules de .markdown-chat estaban muertas. Los nombres de clase son lo
		suficientemente específicos como para no contaminar el resto del sitio.
	-->
	<style is:global>
		.scrollbar-thin::-webkit-scrollbar {
			width: 6px;
		}
		.scrollbar-thin::-webkit-scrollbar-track {
			background: transparent;
		}
		.scrollbar-thin::-webkit-scrollbar-thumb {
			background-color: rgba(75, 85, 99, 0.5); /* gray-600 con opacidad */
			border-radius: 20px;
		}
		/* ESTILOS PARA EL MARKDOWN DEL CHAT */
        .markdown-chat p {
            margin-bottom: 0.75rem;
        }
        .markdown-chat p:last-child {
            margin-bottom: 0;
        }
        .markdown-chat strong {
            font-weight: 700;
            color: white; /* Resalta las negritas en blanco puro sobre el fondo slate */
        }
        .markdown-chat em {
            font-style: italic;
        }
        .markdown-chat ul {
            list-style-type: disc;
            margin-left: 1.5rem;
            margin-bottom: 0.75rem;
        }
        .markdown-chat ol {
            list-style-type: decimal;
            margin-left: 1.5rem;
            margin-bottom: 0.75rem;
        }
        .markdown-chat li {
            margin-bottom: 0.25rem;
        }
        .markdown-chat a {
            color: #50C878;
            text-decoration: underline;
            text-underline-offset: 2px;
        }
        .markdown-chat a:hover {
            color: #3db868;
        }
        .markdown-chat pre {
            background-color: #021336;
            padding: 0.75rem;
            border-radius: 0.5rem;
            overflow-x: auto;
            margin-top: 0.5rem;
            margin-bottom: 0.75rem;
            border: 1px solid #1e293b;
        }
        .markdown-chat code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.85em;
            background-color: rgba(0, 0, 0, 0.3);
            padding: 0.15rem 0.3rem;
            border-radius: 0.25rem;
            color: #50C878;
        }
        /* Evita que el código dentro de un bloque pre tenga fondo extra */
        .markdown-chat pre code {
            background-color: transparent;
            padding: 0;
            color: inherit;
        }
		/* Animación de flotado suave para la burbuja */
        @keyframes bounce-slow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .animate-bounce-slow {
            animation: bounce-slow 3s infinite ease-in-out;
        }

		/* -------------------------------------------------
		   Pantalla de arranque del chat (ver startBoot/finishBoot)
		   ------------------------------------------------- */
        /* `display` se controla acá y no con `hidden`: las utilidades hidden/flex
           de Tailwind compiten por la misma propiedad y el resultado depende del
           orden del CSS generado, no del orden de las clases en el HTML. */
        #boot-splash {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        #boot-splash.is-on { display: flex; }
        #boot-splash.is-out { display: flex; }

        /* Anillos que se expanden desde el avatar mientras Render hiberna/despierta */
        @keyframes boot-ripple {
            0%   { transform: scale(0.72); opacity: 0.5; }
            100% { transform: scale(1.55); opacity: 0; }
        }
        .boot-ring {
            position: absolute;
            /* inset+margin:auto centra el anillo sobre el avatar en vez de
               dejarlo pegado al origen del contenedor flex. */
            inset: 0;
            margin: auto;
            width: 4rem;
            height: 4rem;
            border-radius: 9999px;
            border: 2px solid rgba(80, 200, 120, 0.65);
            animation: boot-ripple 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
        }
        /* Escalonados para que parezcan ondas en lugar de un pulso único */
        .boot-ring:nth-of-type(2) { animation-delay: 0.8s; }
        .boot-ring:nth-of-type(3) { animation-delay: 1.6s; }

        @keyframes boot-pulse {
            0%, 100% { transform: scale(1); }
            50%      { transform: scale(1.06); }
        }
        .boot-avatar { animation: boot-pulse 2.4s ease-in-out infinite; }

        /* Caret del typewriter */
        @keyframes boot-blink {
            0%, 45%   { opacity: 1; }
            55%, 100% { opacity: 0; }
        }
        .boot-caret {
            display: inline-block;
            width: 2px;
            height: 1em;
            margin-left: 2px;
            vertical-align: text-bottom;
            background: #50C878;
            animation: boot-blink 1s steps(1) infinite;
        }

        /* Barrido de brillo que recorre la barra */
        @keyframes boot-sheen {
            from { transform: translateX(-120%); }
            to   { transform: translateX(320%); }
        }

        /* La barra barre 30s como escala visual. El desbloqueo real del input no
           lo dispara esta animación, sino la respuesta de /api/wake. */
        @keyframes boot-fill {
            from { width: 0%; }
            to   { width: 100%; }
        }
        .boot-bar {
            position: relative;
            overflow: hidden;
            width: 0%;
            border-radius: 9999px;
            background: linear-gradient(90deg, #3db868, #50C878);
            box-shadow: 0 0 12px rgba(80, 200, 120, 0.45);
        }
        .boot-bar::after {
            content: "";
            position: absolute;
            inset: 0;
            width: 40%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
            animation: boot-sheen 1.8s ease-in-out infinite;
        }
        .boot-bar--running { animation: boot-fill 30s linear forwards; }

        /* Si Render pasa los 30s, la barra deja de avanzar y el riel pulsa: el
           usuario tiene que ver que seguimos intentando en lugar de una barra
           muerta. El pulso va en el RIEL y no en la barra a propósito: si se
           animara la barra, esta regla pisaría `animation: boot-fill` y la
           barra volvería a 0%. */
        @keyframes boot-stall {
            0%, 100% { opacity: 1; }
            50%      { opacity: 0.3; }
        }
        #boot-track.boot-track--stalled { animation: boot-stall 1.2s ease-in-out infinite; }

        /* Cambio de texto de estado */
        @keyframes boot-swap {
            0%   { opacity: 0; transform: translateY(4px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        #boot-status-text.boot-status--swap { animation: boot-swap 500ms ease-out both; }

        /* Entrada y salida de la pantalla de arranque */
        @keyframes boot-enter {
            from { opacity: 0; transform: translateY(10px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes boot-exit {
            from { opacity: 1; transform: scale(1); }
            to   { opacity: 0; transform: scale(0.95); }
        }
        #boot-splash.is-on { animation: boot-enter 400ms ease-out both; }
        #boot-splash.is-out { animation: boot-exit 350ms ease-in both; }

        /* Entrada de las burbujas. Reemplaza las clases `animate-in fade-in
           slide-in-from-bottom-2` de tailwindcss-animate: ese plugin no está
           instalado, así que las entradas nunca se animaban. */
        @keyframes msg-enter {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .msg-enter { animation: msg-enter 300ms ease-out both; }

        @media (prefers-reduced-motion: reduce) {
            .boot-ring, .boot-avatar, .boot-caret, .boot-bar::after,
            #boot-track.boot-track--stalled { animation: none !important; }
            .boot-caret { opacity: 1; }
            .msg-enter, #boot-splash.is-on, #boot-splash.is-out, #boot-status-text.boot-status--swap {
                animation-duration: 1ms !important;
            }
        }
	</style>
	<script>
		const btn = document.getElementById("load-more-btn");
		const extra = document.getElementById("extra-projects");
		const btnText = document.getElementById("btn-text");
		const btnIcon = document.getElementById("btn-icon");

		btn?.addEventListener("click", () => {
			const isHidden = extra?.classList.contains("hidden");
			if (isHidden) {
				extra?.classList.remove("hidden");
				// Timeout para permitir que el DOM detecte el cambio antes de animar
				setTimeout(() => {
					extra?.classList.remove("opacity-0", "translate-y-4");
				}, 10);
				if (btnText) btnText.textContent = "Ver menos";
				if (btnIcon) btnIcon.style.transform = "rotate(180deg)";
			} else {
				extra?.classList.add("opacity-0", "translate-y-4");
				setTimeout(() => {
					extra?.classList.add("hidden");
				}, 500);
				if (btnText) btnText.textContent = "Ver todos los proyectos";
				if (btnIcon) btnIcon.style.transform = "rotate(0deg)";
				// Scroll suave hacia arriba de la sección al cerrar
				document
					.getElementById("proyectos")
					?.scrollIntoView({ behavior: "smooth" });
			}
		});
	</script>
</html>
